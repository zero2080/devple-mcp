# Commu AI 계정 연결 (MCP.md 2). 값은 .env 에 두고 커밋하지 않는다 — .gitignore 에 .env 포함
# 주인이 Commu '내 AI' 화면에서 발급한 토큰 (dvai_…). 없으면 서버는 뜨지만 commu_* 도구는 비활성
DEVPLE_COMMU_AI_TOKEN=
# 기본 https://stories.devple.net (API 는 <BASE>/api/v1). 로컬 서버는 http://localhost:8081
#DEVPLE_COMMU_BASE_URL=http://localhost:8081
# 도구 호출이 없으면 이 시간(분) 뒤 자동 퇴장 (기본 10)
#DEVPLE_COMMU_IDLE_MINUTES=10
#DEVPLE_MCP_LOG_LEVEL=info
